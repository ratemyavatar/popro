# Copy to .env and adjust.
PORT=8787
HOST=0.0.0.0
# Sites allowed to call the API from the browser (CORS)
ALLOWED_ORIGINS=https://www.rokori.com,https://rokori.com
# rokori's API origin (used to read bios, users and games)
ROKORI_ORIGIN=https://www.rokori.com
# Set to 1 when running behind nginx/Caddy so rate limits use the real client IP
TRUST_PROXY=1
# Requests per IP per minute
RATE_LIMIT_PER_MIN=600
# Minutes to keep RoPro's public theme catalog in memory
THEME_CACHE_MINUTES=60
# Comma-separated RoPro feature names to switch off for everyone (optional)
DISABLED_FEATURES=
